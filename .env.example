# ==============================================================================
# MoneyMate Production & Development Environment Configuration
# Copy this file to .env before starting: `cp .env.example .env`
# ==============================================================================

# --- Application Environment ---
# Options: development, staging, production
NODE_ENV=production

# --- Backend Server Configuration ---
PORT=8080

# --- Database Configuration (PostgreSQL 14+) ---
# For Docker Compose, DB_HOST should be `postgres`
# For local development outside Docker, use `localhost`
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moneymate
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Optional: Direct Database Connection URL (e.g. Supabase, Neon, Render, Railway, AWS RDS)
# If provided, this overrides DB_HOST/PORT/NAME
# DATABASE_URL=jdbc:postgresql://user:password@host:5432/moneymate

# Hibernate Schema Policy (use 'update' for dev/first run, 'validate' for strict prod)
HIBERNATE_DDL_AUTO=update

# Database Connection Pool (HikariCP)
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# --- Security & JWT Token Authentication ---
# MUST be a cryptographically secure random string of at least 32 characters in production!
# Generate one with: openssl rand -base64 48
JWT_SECRET=moneymate_super_secure_jwt_secret_key_2026_finance_app_key_32_bytes
JWT_EXPIRATION_MS=86400000

# --- CORS Allowed Origins (Comma-separated URLs) ---
# Add your production frontend domain(s) here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# --- AI Vision Receipt OCR (Server-Side Only, Optional) ---
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# --- Frontend Client Configuration ---
# VITE_API_URL: Leave empty when using Nginx or Vite built-in /api reverse proxy.
# Set only if the frontend is hosted on a separate domain without a reverse proxy.
VITE_API_URL=
