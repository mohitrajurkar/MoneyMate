# ==============================================================================
# MoneyMate Production & Development Environment Configuration
# Copy this file to .env before starting: `cp .env.example .env`
# ==============================================================================

# --- Application Environment ---
# Options: development, staging, production
NODE_ENV=production

# --- Backend Server Configuration ---
PORT=8080

# --- Database Configuration (PostgreSQL 14+) ---
# Option A: Dedicated Environment Variables
# For Docker Compose: DB_HOST=postgres
# For Local Postgres: DB_HOST=localhost, DB_NAME=moneymate
# For Supabase:       DB_HOST=db.<project-ref>.supabase.co, DB_NAME=postgres, DB_SSLMODE=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moneymate
DB_USERNAME=postgres
DB_PASSWORD=mohit123
DB_SSLMODE=

# Option B: Direct Database Connection URL (Supabase, Neon, Render, Railway, AWS RDS)
# If provided, this overrides DB_HOST/PORT/NAME/USERNAME/PASSWORD.
# Supabase example:
# DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?user=postgres&password=YOUR_PASSWORD&sslmode=require
# Standard URI example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.zyvzdxxahnlcjoyvzpme.supabase.co:5432/postgres?sslmode=require

# Hibernate Schema Policy (use 'update' for dev/first run, 'validate' for strict prod)
HIBERNATE_DDL_AUTO=update

# Hosted PostgreSQL users generally cannot create databases.
DB_AUTO_CREATE=false

# Database Connection Pool (HikariCP)
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# --- Security & JWT Token Authentication ---
# MUST be set to a cryptographically secure random string of at least 32 characters!
# Generate one with: openssl rand -base64 48
JWT_SECRET=your_32_plus_character_secure_random_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# --- CORS Allowed Origins (Comma-separated URLs) ---
# Add your production frontend domain(s) here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# --- AI Vision Receipt OCR (Server-Side Only, Optional) ---
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# --- Frontend Client Configuration ---
# VITE_API_URL: Leave empty when using Nginx or Vite built-in /api reverse proxy.
# Set only if the frontend is hosted on a separate domain without a reverse proxy.
VITE_API_URL=
