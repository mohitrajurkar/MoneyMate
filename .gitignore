# ==============================================================================
# MoneyMate Production .gitignore
# ==============================================================================

# --- Node & Frontend Build Artifacts ---
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
.output/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secret Configuration ---
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# --- Java & Maven Build Artifacts ---
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar

# --- IDE & Editor Artifacts ---
.idea/
*.iml
*.ipr
*.iws
.settings/
.project
.classpath
.factorypath
.metadata/
bin/

# Keep essential VS Code workspace configuration if needed, ignore user-specific state
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- OS System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Temporary & Crash Files ---
*.tmp
*.bak
*.swp
*~
.hprof
